<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= it.title %></title>
    <style>
        body { font-family: sans-serif; margin: 40px; line-height: 1.6; }
        main { max-width: 600px; margin: 0 auto; }
        .entry { border: 1px solid #ccc; padding: 15px; margin-bottom: 15px; border-radius: 4px; }
        .entry-header { font-weight: bold; color: #555; margin-bottom: 5px; }
        .entry-time { font-size: 0.8em; color: #888; margin-left: 10px; }
        form { margin-top: 30px; border-top: 1px solid #eee; padding-top: 20px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input[type="text"], textarea { width: 100%; padding: 8px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        input[type="submit"] { background: #007bff; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 4px; }
        input[type="submit"]:hover { background: #0056b3; }
    </style>
</head>
<body>
    <main>
        <h1><%= it.title %></h1>
        
        <h2>Entries</h2>
        <% if (it.entries && it.entries.length > 0) { %>
            <% it.entries.forEach(function(entry) { %>
                <div class="entry">
                    <div class="entry-header">
                        <span><%= entry.name %></span>
                        <span class="entry-time">(<%= entry.createdAt %>)</span>
                    </div>
                    <div class="entry-body"><%= entry.message %></div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No entries yet. Be the first to write something!</p>
        <% } %>

        <form method="POST" action="/">
            <h2>Add your entry</h2>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" required>
            
            <label for="message">Message:</label>
            <textarea id="message" name="message" rows="4" required></textarea>
            
            <input type="submit" value="Add Entry">
            <input type="reset" value="Reset">
        </form>
    </main>
</body>
</html>
